# ==============================================================================
# Hermes Agent - Environment Configuration Example File (.env.example)
# ==============================================================================

# LLM Provider API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

HERMES_MODEL_PROVIDER=openrouter
HERMES_MODEL=meta-llama/llama-3-70b-instruct

# Gateway API Server Configuration
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=secure_api_key_for_dashboard_connections
DASHBOARD_PORT=9119

# MCP (Model Context Protocol) Integration Placeholders
MCP_FILESYSTEM_ALLOWED_PATHS=E:/xampp/htdocs/Projects/Hermes/data
MCP_GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
MCP_GITHUB_DEFAULT_USER_OR_ORG=your_github_username
MCP_BROWSER_HEADLESS=true
AGENT_BROWSER_EXECUTABLE_PATH=
MCP_POSTGRES_HOST=localhost
MCP_POSTGRES_PORT=5432
MCP_POSTGRES_DB=hermes_db
MCP_POSTGRES_USER=postgres
MCP_POSTGRES_PASSWORD=your_postgres_password_here
MCP_GOOGLE_DRIVE_CLIENT_ID=your_google_client_id_here
MCP_GOOGLE_DRIVE_CLIENT_SECRET=your_google_client_secret_here
MCP_GOOGLE_DRIVE_REFRESH_TOKEN=your_google_refresh_token_here
TAVILY_API_KEY=your_tavily_api_key_here
GOOGLE_SEARCH_API_KEY=your_google_search_key_here
GOOGLE_CSE_ID=your_google_custom_search_engine_id_here
